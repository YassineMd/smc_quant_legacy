# /etc/caddy/Caddyfile -- HTTPS for the Claude app's connector (2026-09-24). Installed from
# android/deploy/Caddyfile.template with __TOKEN__ replaced by a random secret (python3 -c "import secrets;
# print(secrets.token_urlsafe(24))"); the file on the VM is root:caddy 0640 and the secret is NEVER committed.
# The connector URL is  https://34-155-14-220.sslip.io/__TOKEN__/mcp
# sslip.io resolves 34-155-14-220.sslip.io to 34.155.14.220 (the reserved smc-quant-ip); Caddy gets and renews the
# Let's Encrypt certificate itself (ports 80/443: the VM's http-server / https-server tags).
{
	# no access log: a logged URL would contain the secret
	servers {
		timeouts {
			read_body 10s
			read_header 10s
			idle 2m
		}
	}
}

34-155-14-220.sslip.io {
	@mcp path /__TOKEN__/mcp /__TOKEN__/mcp/*
	handle @mcp {
		request_body {
			max_size 64KB
		}
		uri strip_prefix /__TOKEN__
		reverse_proxy 127.0.0.1:8770 {
			# the MCP SDK's DNS-rebinding guard only accepts a local Host, and no browser Origin
			header_up Host 127.0.0.1:8770
			header_up -Origin
		}
	}
	handle {
		respond 404
	}
}
