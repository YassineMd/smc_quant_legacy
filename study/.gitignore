# raw snapshots + big generated datasets stay out of git (regenerable / reference gitignored data)
data/*
out/*
# ...but track the small code-required / deliverable text artifacts (own-line comments; git has no inline):
# - column_contract.tsv: the enumerated 1281-code contract that build_dataset.py reads
# - extraction_report.md: the banked validation report
# - deferred_codes.tsv: the on-demand enrichment shopping list
!data/column_contract.tsv
!out/extraction_report.md
!out/deferred_codes.tsv
# analysis-phase deliverables (reports + result CSVs + frozen params)
!out/analysis_report_A_discovery.md
!out/analysis_report_C_autopsy.md
!out/analysis_report_D_walkforward.md
!out/screening_long.csv
!out/screening_short.csv
!out/correlation_long.csv
!out/correlation_short.csv
!out/score_weights.csv
!out/walkforward_trades.csv
!out/exam_frozen.json
!out/decomposition_direction.csv
!out/decomposition_movement.csv
!out/frame_sweep.csv
!out/score_weights_k*.csv
!out/weight_sweep_summary.csv
!out/weight_sweep_summary_ext.csv
!out/analysis_report_S1_geometry.md
!out/scalp_geometry_grid.csv
!out/scalp_mfe_mae.csv
!out/timeofday_map.csv
